APP_ENV=local
FLASK_PORT=5000

# Local fallback database. Supabase is the target enterprise data layer.
DATABASE_PATH=backend/smartqa.db

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Leave empty unless your local network needs a proxy for Supabase REST.
SUPABASE_HTTP_PROXY=
SUPABASE_HTTPS_PROXY=
# Set true so internal workbench APIs require Supabase Auth bearer tokens.
INTERNAL_AUTH_REQUIRED=true
# Used to sign customer web access tokens. Set a long random value in production.
CUSTOMER_ACCESS_TOKEN_SECRET=

# Dify local Docker API
DIFY_API_URL=http://localhost/v1
DIFY_API_KEY=
DIFY_USER=smartqa-system
# auto tries the chat endpoint and falls back to workflow when the app key requires it.
# Set workflow for Dify Workflow App keys to avoid one extra HTTP round-trip.
DIFY_APP_MODE=auto
MOCK_AI_ENABLED=true

# Enterprise WeChat self-built app
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# Optional: WeCom Customer Service. If empty, the self-built app secret is used
# for local integration checks, but production should use the customer-service secret.
WECOM_KF_SECRET=
WECOM_KF_OPEN_KFID=
WECOM_KF_POLL_ENABLED=false
WECOM_KF_POLL_INTERVAL_SECONDS=15
WECOM_KF_IMMEDIATE_ACK_ENABLED=true
WECOM_KF_IMMEDIATE_ACK_TEXT=已收到，我正在查询产品资料和报价规则，请稍等。
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# Optional public HTTPS tunnel root, for example https://abc.trycloudflare.com
WECOM_PUBLIC_BASE_URL=

# Operations alerting. Use WeCom internal user IDs separated by |, for example zhangsan|lisi.
OPERATIONS_ALERTS_ENABLED=false
OPERATIONS_ALERT_RECIPIENTS=
OPERATIONS_ALERT_MIN_SEVERITY=warning
